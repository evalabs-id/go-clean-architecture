export APP_NAME=app_name
export APP_VERSION=1.0.0
export APP_ENVIRONMENT=development

export SERVER_PORT=5000
export SERVER_DEBUG=true
export SERVER_TIMEZONE=Asia/Jakarta

export API_KEY=api_key

export DB_DRIVER=postgres
export DB_HOST=localhost
export DB_PORT=5432
export DB_USERNAME=postgres
export DB_PASSWORD=password
export DB_NAME=your_db_name
export DB_SSLMODE=disable

export JWT_SECRET_KEY=jwt_secret_key
export JWT_ACCESS_TOKEN_DURATION=1h
export JWT_REFRESH_TOKEN_DURATION=720h
export JWT_ISSUER=issuer_name

export GOOSE_DRIVER="$DB_DRIVER"
export GOOSE_DBSTRING="$DB_DRIVER://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME?sslmode=$DB_SSLMODE"
export GOOSE_MIGRATION_DIR="migrations"
